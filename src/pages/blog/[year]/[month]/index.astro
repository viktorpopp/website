---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getAllPosts, monthName } from "../../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const keys = new Set(posts.map((p) => `${p.year}/${p.month}`));
  return [...keys].map((key) => {
    const [year, month] = key.split("/");
    return {
      params: { year, month },
      props: {
        posts: posts.filter((p) => p.year === year && p.month === month),
      },
    };
  });
}

const { year, month } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout>
  <h1>{monthName(month!)} {year}</h1>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={post.url}>{post.entry.data.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
