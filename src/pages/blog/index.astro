---
import CatFace from "../../components/CatFace.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts } from "../../lib/posts";

const posts = await getAllPosts();
---

<BaseLayout title="Blog">
  <h1>My blog <CatFace /></h1>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={post.url}>{post.entry.data.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
